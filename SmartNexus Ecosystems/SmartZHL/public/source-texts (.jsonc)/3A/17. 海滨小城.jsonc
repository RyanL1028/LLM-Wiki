// 海滨小城 (The Seaside Town) — 3A 第六单元 L17 — prose
{
  "id": "haibin",
  "title": "海滨小城",
  "sub": "The Seaside Town",
  "icon": "🏖️",
  "level": "Intermediate",
  "category": "prose",
