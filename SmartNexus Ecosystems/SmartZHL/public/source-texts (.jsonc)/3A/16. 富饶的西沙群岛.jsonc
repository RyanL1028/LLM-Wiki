// 富饶的西沙群岛 (The Rich Xisha Islands) — 3A 第六单元 L16 — prose
{
  "id": "xisha",
  "title": "富饶的西沙群岛",
  "sub": "The Rich Xisha Islands",
  "icon": "🏝️",
  "level": "Intermediate",
  "category": "prose",
