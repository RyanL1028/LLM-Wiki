// 夜书所见 (What I Saw When Writing at Night) — 3A 第二单元 L4C — poem
{
  "id": "yeshusuojian",
  "title": "夜书所见",
  "sub": "What I Saw When Writing at Night",
  "icon": "🌙",
  "level": "Intermediate",
  "category": "poem",
  "syllabus": "3A",
  "unit": "第二单元",
  "lessonNo": "4C",
  "type": "poem",
  "text": [
    "夜 书 所 见",
    "[宋] 叶 绍 翁",
    "萧 萧 梧 叶 送 寒 声 ，",
    "江 上 秋 风 动 客 情 。",
    "知 有 儿 童 挑 促 织 ，",
    "夜 深 篱 落 一 灯 明 。"
  ]
}
