rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /homework/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (exists(/databases/(default)/documents/users/$(request.auth.uid))
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['teacher', 'admin', 'ultimateadmin']);
      allow delete: if request.auth != null
        && (exists(/databases/(default)/documents/users/$(request.auth.uid))
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'ultimateadmin');
    }
    match /pfp/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /chatFiles/{convId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
